# 换行符规范
# 背景：Windows 工作区是 CRLF，若绕过 git 直接把文件拷到 termux（scp/tar），
# bash 会读到 \r 并报 "set: pipefail: invalid option name" 之类怪错，脚本全线崩。
# 仓库 blob 本身已是 LF；这里再显式钉死脚本类文件 eol=lf，
# 防止将来有人在 autocrlf=false 的机器上提交出 CRLF blob。

# 默认自动检测 + 规范化
* text=auto

# 必须 LF：会被 Linux/termux 直接执行或解析的文件
*.sh      text eol=lf
*.bash    text eol=lf
*.py      text eol=lf
*.js      text eol=lf
*.cjs     text eol=lf
*.mjs     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.conf    text eol=lf
*.service text eol=lf
Makefile  text eol=lf

# 二进制：不做任何换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.mp4  binary
*.mp3  binary
*.zip  binary
*.gz   binary
*.tgz  binary
*.pbf  binary
*.mbtiles binary
